# Repo the pipeline operates on (defaults to `git rev-parse --show-toplevel`)
PIPELINE_REPO=/home/nocco/Documenti/progetti/dnn-vtt/nexus-vtt

# Where pipeline docs live (plans, debates, reviews, metrics, etc.)
# Defaults to MonkeForge/docs/<repo-name>/ (e.g. docs/nexus-vtt/).
# Override to place docs elsewhere (e.g. inside the repo: PIPELINE_DOCS_DIR=<repo>/docs).
# PIPELINE_DOCS_DIR=/path/to/docs

# Architecture/domain docs the agents must read. ";"-separated, repo-relative.
# Docs listed but not yet created are skipped; they appear automatically once added.
# PIPELINE_ARCH_DOCS=frontend/ARCHITECTURE.md;frontend/AGENTS.md;backend/ARCHITECTURE.md;docs/database_schema.md;docs/network_protocol.md;docs/combat_engine.md;docs/render_pipeline.md;docs/character_ingestion.md;docs/fog_of_war.md;docs/UX-MANIFESTO.md

# Set to 1 to wire-test the graph without invoking any agent
# PIPELINE_DRY_RUN=1

# Hard timeout per agent step, in seconds (0/unset = no limit). RECOMMENDED to
# set: with no limit, an agent whose backend hangs (e.g. the devin daemon stops
# responding, producing zero output) blocks the run forever with no recovery.
# A timeout makes proc.wait() raise, which becomes a step_error → escalation.
# 1800 (30 min) leaves room for a slow batch while catching a true hang.
# PIPELINE_Agemini-3.6-flash: pro failed the file-read tool call on 008/009;
# flash passed two smoke tests (incl. reading UX-MANIFESTO.md). Faster, and the
# retry + rubber-stamp guard remain as backstops. composer is out of usage.GENT_TIMEOUT=1800

# --- Cycle / retry limits (all have sensible defaults) ---

# Max debate rounds (critique → reply cycles) before verification-only pass
# PIPELINE_MAX_DEBATE_ROUNDS=2

# Max code fix cycles per batch (code_review → code_fix → code_verify loop)
# PIPELINE_MAX_FIX_CYCLES=2

# Max test fix retries per batch (implementer retries after test failures)
# PIPELINE_MAX_TEST_FIXES=2

# Max intake interview rounds (question → answer cycles)
# PIPELINE_MAX_INTAKE_ROUNDS=4

# Max visual render/fix cycles (ux_render → ux_visual_review → ux_visual_fix loop)
# PIPELINE_MAX_UX_RENDER_CYCLES=3

# Max render measure/fix cycles (render_measure → render_review → render_fix loop)
# PIPELINE_MAX_RENDER_CYCLES=3

# Consecutive non-improving cycles before visual/render gates escalate early
# (plateau detection — the fix loop is oscillating, not converging)
# PIPELINE_PLATEAU_THRESHOLD=2

# --- Agent retry / health ---

# Transient retry count for any agent (rate limits, connection resets, signals)
# PIPELINE_AGENT_TRANSIENT_RETRIES=1

# Backoff seconds between transient retries
# PIPELINE_AGENT_BACKOFF_S=8

# UX reviewer specific retries (gemini malformed-tool-call recovery)
# PIPELINE_UX_REVIEW_RETRIES=3

# UX reviewer backoff between retries
# PIPELINE_UX_REVIEW_BACKOFF_S=10

# Minimum output bytes for an agent to be considered healthy (below = hard failure)
# PIPELINE_MIN_OUTPUT_BYTES=40

# Heartbeat interval (seconds) for current.json updates during long agent runs
# PIPELINE_HEARTBEAT_INTERVAL_S=10

# --- Graph / git ---

# LangGraph recursion limit (max nodes per stream). Raise for pipelines with
# many batches + fix cycles that approach the default.
# PIPELINE_RECURSION_LIMIT=200

# Git branch prefix for task branches (default: feature/task-)
# PIPELINE_BRANCH_PREFIX=feature/task-

# Override per role: model + command together. Placeholders in cmd: {model},
# {prompt}, {prompt_file}. First token of cmd = CLI binary (checked by preflight).

# INTERVIEWER
# PIPELINE_MODEL_INTERVIEWER=gemini-3.1-pro-preview
# PIPELINE_CMD_INTERVIEWER=gemini -m {model} -p {prompt}

# PROPOSER
# PIPELINE_MODEL_PROPOSER=glm-5.2
# PIPELINE_CMD_PROPOSER=stdbuf -oL devin --model {model} --prompt-file {prompt_file} -p --permission-mode dangerous

# PLAN_REVIEWER
# PIPELINE_MODEL_PLAN_REVIEWER=codex
# PIPELINE_CMD_PLAN_REVIEWER=stdbuf -oL devin --model {model} --prompt-file {prompt_file} -p --permission-mode dangerous

# IMPLEMENTER
# PIPELINE_MODEL_IMPLEMENTER=glm-5.2
# PIPELINE_CMD_IMPLEMENTER=stdbuf -oL devin --model {model} --prompt-file {prompt_file} -p --permission-mode dangerous

# CODE_REVIEWER
# PIPELINE_MODEL_CODE_REVIEWER=codex
# PIPELINE_CMD_CODE_REVIEWER=stdbuf -oL devin --model {model} --prompt-file {prompt_file} -p --permission-mode dangerous

# UX_REVIEWER
# PIPELINE_MODEL_UX_REVIEWER=gemini-3.1-pro-preview
# PIPELINE_CMD_UX_REVIEWER=gemini -m {model} -p {prompt}

# SUMMARIZER
# PIPELINE_MODEL_SUMMARIZER=glm-5.2
# PIPELINE_CMD_SUMMARIZER=stdbuf -oL devin --model {model} --prompt-file {prompt_file} -p --permission-mode dangerous

# JUDGE
# PIPELINE_MODEL_JUDGE=sonnet
# PIPELINE_CMD_JUDGE=claude -p {prompt} --model {model}

# VISUAL_REVIEWER (reviews rendered screenshots — must reliably read image files)
# PIPELINE_MODEL_VISUAL_REVIEWER=sonnet
# PIPELINE_CMD_VISUAL_REVIEWER=claude -p {prompt} --model {model}

# VISUAL_FIXER (fixes visual blockers — must see screenshots + edit frontend)
# PIPELINE_MODEL_VISUAL_FIXER=sonnet
# PIPELINE_CMD_VISUAL_FIXER=claude -p {prompt} --model {model}

# --- Infrastructure (all optional, defaults match the nexus-vtt monorepo) ---

# Test suites for the in-graph test gate. Format: "label:subdir:ENV=val;label2:subdir2:"
# Use {e2e_db} to interpolate E2E_DATABASE_URL. Empty string disables the gate.
# PIPELINE_TEST_SUITES=backend:backend:DATABASE_URL={e2e_db};frontend:frontend:

# E2E database (for DB-backed tests). Override if your DB is elsewhere.
# PIPELINE_E2E_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/nexusvtt?schema=public
# PIPELINE_E2E_DB_PORT=5433
# PIPELINE_E2E_DB_CONTAINER=nexus_vtt_e2e_db
# PIPELINE_E2E_PROJECT=nexus-vtt-e2e

# Script to bring the e2e stack up (idempotent). If not found, DB-gated tests are skipped.
# PIPELINE_E2E_UP_SCRIPT=/path/to/e2e-up.sh

# Timeout for the e2e stack startup script (seconds)
# PIPELINE_E2E_UP_TIMEOUT=660

# --- Visual gate (Playwright render of built UI to screenshots) ---

# Seed script for fixed-id render fixtures (idempotent upsert, run before rendering)
# PIPELINE_UX_SEED_SCRIPT=/path/to/e2e-seed-ux-fixtures.sh

# Playwright spec that renders the UI to screenshots. Must honour UX_RENDER_OUT.
# Empty value disables the whole visual phase.
# PIPELINE_UX_RENDER_CMD=npx playwright test tests/e2e/ux-render.spec.ts --project=chromium
# PIPELINE_UX_RENDER_CWD=frontend
# PIPELINE_UX_RENDER_TIMEOUT=720

# --- Render gate (perf: counts re-renders per instrumented subtree) ---

# Playwright spec that profiles re-renders. Reuses the ux-render seed fixtures.
# PIPELINE_RENDER_CMD=npx playwright test tests/e2e/render-profile.spec.ts --project=chromium
# PIPELINE_RENDER_CWD=frontend
# PIPELINE_RENDER_TIMEOUT=300

# --- Notifications ---

# Notification level: silent (never push), milestones (only human-actionable, DEFAULT),
# all (every step — debug opt-in, verbose)
# PIPELINE_NOTIFY_LEVEL=milestones

# --- Notify daemon (persistent rate-limited notification dispatcher) ---

# Messages allowed per rate-limit window
# PIPELINE_NOTIFY_RATE=30

# Rate-limit window in seconds
# PIPELINE_NOTIFY_WINDOW=60

# Unix socket path for the daemon (default: <docs>/metrics/notify.sock)
# PIPELINE_NOTIFY_SOCKET=/path/to/notify.sock

# --- Discord bot (optional, for escalation relay) ---

# Set to 1/true/yes to auto-launch the bot as a detached process on start/resume
# PIPELINE_BOT_AUTOSTART=1

# DISCORD_BOT_NAME=Pipeline multi-agent
# DISCORD_BOT_AVATAR=https://example.com/avatar.png
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# DISCORD_BOT_TOKEN=...
# DISCORD_CHANNEL_ID=...
# DISCORD_ALLOWED_USER_IDS=...

# Needed only for LangGraph Studio
# LANGSMITH_API_KEY=lsv2_...
